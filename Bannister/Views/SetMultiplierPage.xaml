<?xml version="1.0" encoding="utf-8" ?>

<mode:ModeThemedPage xmlns:mode="clr-namespace:Bannister.Views" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Bannister.Views.SetMultiplierPage" Title="Set Multiplier" xmlns:theme="clr-namespace:Bannister.Services">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20" VerticalOptions="Center" MaximumWidthRequest="400">

        <!-- Title -->
        <Label Text="Set Multiplier" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />

        <!-- Description -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="Set multiplier for:" FontSize="14" />
            <Label x:Name="lblActivityName" Text="Activity Name" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource ModePageText1}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=PageText1" />
        </VerticalStackLayout>

        <!-- Multiplier Input -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="Multiplier:" FontSize="14" FontAttributes="Bold" />
            <Entry x:Name="txtMultiplier" Text="3" Keyboard="Numeric" FontSize="16" TextChanged="OnMultiplierChanged" />
            <Label x:Name="lblPreview" Text="→ 10 × 3 = 30 EXP" TextColor="{DynamicResource ModePageText1}" FontSize="14" theme:ThemeColorExtensions.NamedColorProperties="TextColor=PageText1" />
        </VerticalStackLayout>

        <!-- Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Set" Clicked="OnSetClicked" BackgroundColor="{DynamicResource ModeSecondaryButtonBackground}" TextColor="{DynamicResource ModeButtonPrimaryText}" CornerRadius="8" HeightRequest="50" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SecondaryButtonBackground,TextColor=ButtonPrimaryText" />
            <Button Text="Cancel" Grid.Column="1" Clicked="OnCancelClicked" BackgroundColor="{DynamicResource ModeNeutralButtonBackground}" TextColor="{DynamicResource ModeCardText1}" CornerRadius="8" HeightRequest="50" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=NeutralButtonBackground,TextColor=CardText1" />
        </Grid>

    </Grid>
</mode:ModeThemedPage>
