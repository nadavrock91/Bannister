<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bannister.Views.LoginPage"
             Title="Login"
             BackgroundColor="#F5F5F5">

    <FlyoutBase.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="Import Data from Backup" Clicked="OnImportClicked" />
            <MenuFlyoutItem Text="Export Data to Backup" Clicked="OnExportClicked" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Open Data Folder" Clicked="OnOpenDataFolderClicked" />
        </MenuFlyout>
    </FlyoutBase.ContextFlyout>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Long-press gesture for mobile -->
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLongPress" NumberOfTapsRequired="1" />
            </VerticalStackLayout.GestureRecognizers>

            <Label Text="🐉" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Bannister" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Slay your dragons" HorizontalOptions="Center" TextColor="Gray" />

            <Frame x:Name="DatabaseMissingSection"
                   IsVisible="False"
                   BackgroundColor="White"
                   Padding="20"
                   CornerRadius="10"
                   Margin="0,20,0,0">
                <VerticalStackLayout Spacing="14">
                    <Label Text="No Bannister database found on this device."
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Select existing database"
                            Clicked="OnSelectExistingDatabaseClicked"
                            BackgroundColor="#3949AB"
                            TextColor="White"
                            CornerRadius="8" />
                    <Button Text="Create new database"
                            Clicked="OnCreateNewDatabaseClicked"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            CornerRadius="8" />
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="LoginSection" BackgroundColor="White" Padding="20" CornerRadius="10" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="16">

                    <Label x:Name="lblTitle" Text="Welcome Back" FontSize="18" FontAttributes="Bold" />

                    <Entry x:Name="txtUsername"
                           Placeholder="Username"
                           TextColor="#222"
                           PlaceholderColor="#999"
                           BackgroundColor="#FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Entry x:Name="txtPassword"
                               Grid.Column="0"
                               Placeholder="Password"
                               IsPassword="True"
                               TextChanged="OnPasswordTextChanged"
                               TextColor="#222"
                               PlaceholderColor="#999"
                               BackgroundColor="#FFFFFF" />
                        <Button x:Name="btnTogglePasswordVisibility"
                                Grid.Column="1"
                                Text="👁"
                                FontSize="16"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent"
                                TextColor="#555"
                                Clicked="OnTogglePasswordVisibilityClicked" />
                    </Grid>
                    <Label x:Name="lblPasswordCharacterCount"
                           IsVisible="False"
                           FontSize="11"
                           TextColor="#666"
                           Margin="0,-12,0,0"
                           LineBreakMode="CharacterWrap" />

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="chkRemember" Color="#6200EE" />
                        <Label Text="Remember me" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label x:Name="lblError" TextColor="Red" IsVisible="False" />

                    <Button x:Name="btnLogin" Text="Login" Clicked="OnLoginClicked"
                            BackgroundColor="#6200EE" TextColor="White" CornerRadius="8" HeightRequest="48" />

                    <Button x:Name="btnToggle" Text="Need an account?" Clicked="OnToggleClicked"
                            BackgroundColor="Transparent" TextColor="#6200EE" />

                    <Button x:Name="btnImportFromSync" Text="Import from Another Device" Clicked="OnImportFromSyncClicked"
                            BackgroundColor="#F3F0FF" TextColor="#4B3FBF" BorderColor="#D6D0FF" BorderWidth="1"
                            CornerRadius="8" HeightRequest="42" FontSize="13" />

                    <Button x:Name="btnTestDev" Text="TEST (DEV)" Clicked="OnTestDevClicked"
                            BackgroundColor="White" TextColor="#333" BorderColor="#CCC" BorderWidth="1" CornerRadius="8" HeightRequest="48" IsVisible="False" />

                    <Button x:Name="btnRunFix" Text="Run Fix (DEV)" Clicked="OnRunFixClicked"
                            BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8" HeightRequest="48" IsVisible="False" />

                    <Button x:Name="btnDeleteDb" Text="Delete Database (DEV)" Clicked="OnDeleteDatabaseClicked"
                            BackgroundColor="#FF5722" TextColor="White" CornerRadius="8" HeightRequest="40" FontSize="12" IsVisible="False" />

                </VerticalStackLayout>
            </Frame>

            <Label Text="💡 Right-click or long-press for options" FontSize="12" TextColor="Gray" HorizontalOptions="Center" Opacity="0.6" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
