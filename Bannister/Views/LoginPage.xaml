<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Bannister.Views.LoginPage" Title="Login" BackgroundColor="{DynamicResource ModeSecondarySurface}" xmlns:theme="clr-namespace:Bannister.Services" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SecondarySurface">

    <FlyoutBase.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="Import Data from Backup" Clicked="OnImportClicked" />
            <MenuFlyoutItem Text="Export Data to Backup" Clicked="OnExportClicked" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Open Data Folder" Clicked="OnOpenDataFolderClicked" />
        </MenuFlyout>
    </FlyoutBase.ContextFlyout>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Long-press gesture for mobile -->
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLongPress" NumberOfTapsRequired="1" />
            </VerticalStackLayout.GestureRecognizers>

            <Label Text="🐉" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Bannister" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Slay your dragons" HorizontalOptions="Center" TextColor="{DynamicResource ModeCardText2}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=CardText2" />

            <Frame x:Name="DatabaseMissingSection" IsVisible="False" BackgroundColor="{DynamicResource ModeCardBackground}" Padding="20" CornerRadius="10" Margin="0,20,0,0" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=CardBackground">
                <VerticalStackLayout Spacing="14">
                    <Label Text="No Bannister database found on this device." FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Button Text="Select existing database" Clicked="OnSelectExistingDatabaseClicked" BackgroundColor="{DynamicResource ModeHighlightIndigoText}" TextColor="{DynamicResource ModeButtonPrimaryText}" CornerRadius="8" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=HighlightIndigoText,TextColor=ButtonPrimaryText" />
                    <Button Text="Create new database" Clicked="OnCreateNewDatabaseClicked" BackgroundColor="{DynamicResource ModeSuccessButtonBackground}" TextColor="{DynamicResource ModeButtonPrimaryText}" CornerRadius="8" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SuccessButtonBackground,TextColor=ButtonPrimaryText" />
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="LoginSection" BackgroundColor="{DynamicResource ModeCardBackground}" Padding="20" CornerRadius="10" Margin="0,20,0,0" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=CardBackground">
                <VerticalStackLayout Spacing="16">

                    <Label x:Name="lblTitle" Text="Welcome Back" FontSize="18" FontAttributes="Bold" />

                    <Entry x:Name="txtUsername" Placeholder="Username" TextColor="{DynamicResource ModeInputText}" PlaceholderColor="{DynamicResource ModeCardText3}" BackgroundColor="{DynamicResource ModeInputBackground}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=InputText,PlaceholderColor=CardText3,BackgroundColor=InputBackground" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Entry x:Name="txtPassword" Grid.Column="0" Placeholder="Password" IsPassword="True" TextChanged="OnPasswordTextChanged" TextColor="{DynamicResource ModeInputText}" PlaceholderColor="{DynamicResource ModeCardText3}" BackgroundColor="{DynamicResource ModeInputBackground}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=InputText,PlaceholderColor=CardText3,BackgroundColor=InputBackground" />
                        <Button x:Name="btnTogglePasswordVisibility" Grid.Column="1" Text="👁" FontSize="16" WidthRequest="40" HeightRequest="40" Padding="0" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="{DynamicResource ModeCardText2}" Clicked="OnTogglePasswordVisibilityClicked" theme:ThemeColorExtensions.NamedColorProperties="TextColor=CardText2" />
                    </Grid>
                    <Label x:Name="lblPasswordCharacterCount" IsVisible="False" FontSize="11" TextColor="{DynamicResource ModeCardText2}" Margin="0,-12,0,0" LineBreakMode="CharacterWrap" theme:ThemeColorExtensions.NamedColorProperties="TextColor=CardText2" />

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="chkRemember" Color="{DynamicResource ModeHighlightVioletText}" theme:ThemeColorExtensions.NamedColorProperties="Color=HighlightVioletText" />
                        <Label Text="Remember me" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label x:Name="lblError" TextColor="{DynamicResource ModeErrorText}" IsVisible="False" theme:ThemeColorExtensions.NamedColorProperties="TextColor=ErrorText" />

                    <Button x:Name="btnLogin" Text="Login" Clicked="OnLoginClicked" BackgroundColor="{DynamicResource ModeHighlightVioletText}" TextColor="{DynamicResource ModeButtonPrimaryText}" CornerRadius="8" HeightRequest="48" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=HighlightVioletText,TextColor=ButtonPrimaryText" />

                    <Button x:Name="btnToggle" Text="Need an account?" Clicked="OnToggleClicked" BackgroundColor="Transparent" TextColor="{DynamicResource ModeHighlightVioletText}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=HighlightVioletText" />

                    <Button x:Name="btnImportFromSync" Text="Import from Another Device" Clicked="OnImportFromSyncClicked" BackgroundColor="{DynamicResource ModeHighlightViolet}" TextColor="{DynamicResource ModeHighlightVioletText}" BorderColor="{DynamicResource ModeHighlightIndigo}" BorderWidth="1" CornerRadius="8" HeightRequest="42" FontSize="13" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=HighlightViolet,TextColor=HighlightVioletText,BorderColor=HighlightIndigo" />

                    <Button x:Name="btnTestDev" Text="TEST (DEV)" Clicked="OnTestDevClicked" BackgroundColor="{DynamicResource ModeCardBackground}" TextColor="{DynamicResource ModeCardText1}" BorderColor="{DynamicResource ModeSeparator}" BorderWidth="1" CornerRadius="8" HeightRequest="48" IsVisible="False" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=CardBackground,TextColor=CardText1,BorderColor=Separator" />

                    <Button x:Name="btnRunFix" Text="Run Fix (DEV)" Clicked="OnRunFixClicked" BackgroundColor="{DynamicResource ModeSuccessButtonBackground}" TextColor="{DynamicResource ModeButtonPrimaryText}" CornerRadius="8" HeightRequest="48" IsVisible="False" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SuccessButtonBackground,TextColor=ButtonPrimaryText" />

                    <Button x:Name="btnDeleteDb" Text="Delete Database (DEV)" Clicked="OnDeleteDatabaseClicked" BackgroundColor="{DynamicResource ModeWarningButtonBackground}" TextColor="{DynamicResource ModeButtonPrimaryText}" CornerRadius="8" HeightRequest="40" FontSize="12" IsVisible="False" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=WarningButtonBackground,TextColor=ButtonPrimaryText" />

                </VerticalStackLayout>
            </Frame>

            <Label Text="💡 Right-click or long-press for options" FontSize="12" TextColor="{DynamicResource ModeCardText2}" HorizontalOptions="Center" Opacity="0.6" theme:ThemeColorExtensions.NamedColorProperties="TextColor=CardText2" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
