<?xml version="1.0" encoding="utf-8" ?>

<mode:ModeThemedPage xmlns:mode="clr-namespace:Bannister.Views" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Bannister.Views.ManageActivitiesPage" Title="Manage Activities" xmlns:theme="clr-namespace:Bannister.Services">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="15">
        
        <!-- Search and Filter Bar -->
        <Frame Grid.Row="0" Padding="15" CornerRadius="12" BackgroundColor="{DynamicResource ModeCardBackground}" HasShadow="True" BorderColor="Transparent" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=CardBackground">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                
                <!-- Search Box -->
                <SearchBar x:Name="searchBar" Grid.Row="0" Placeholder="Search activities..." TextChanged="OnSearchTextChanged" SearchButtonPressed="OnSearchPressed" />
                
                <!-- Filter Options -->
                <HorizontalStackLayout Grid.Row="1" Spacing="10">
                    <Label Text="Category:" VerticalOptions="Center" />
                    <Picker x:Name="categoryFilter" WidthRequest="150" SelectedIndexChanged="OnCategoryFilterChanged" />
                    
                    <Label Text="Sort:" VerticalOptions="Center" Margin="20,0,0,0" />
                    <Picker x:Name="sortPicker" WidthRequest="150" SelectedIndexChanged="OnSortChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Name (A-Z)</x:String>
                                <x:String>Name (Z-A)</x:String>
                                <x:String>EXP (High to Low)</x:String>
                                <x:String>EXP (Low to High)</x:String>
                                <x:String>Category</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </HorizontalStackLayout>
            </Grid>
        </Frame>

        <!-- Activities List -->
        <Border Grid.Row="1" Stroke="{DynamicResource ModeSeparator}" StrokeThickness="1" BackgroundColor="{DynamicResource ModeCardBackground}" Padding="0" theme:ThemeColorExtensions.NamedColorProperties="Stroke=Separator,BackgroundColor=CardBackground">
            <CollectionView x:Name="activitiesList" SelectionMode="Multiple">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12" Margin="8" CornerRadius="8" BackgroundColor="{DynamicResource ModeSecondarySurface}" BorderColor="{DynamicResource ModeSeparator}" HasShadow="False" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SecondarySurface,BorderColor=Separator">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="15">
                                
                                <!-- Activity Image -->
                                <Frame Grid.Column="0" Padding="0" CornerRadius="8" WidthRequest="60" HeightRequest="60" IsClippedToBounds="True" BorderColor="{DynamicResource ModeSeparator}" HasShadow="False" theme:ThemeColorExtensions.NamedColorProperties="BorderColor=Separator">
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                </Frame>

                                <!-- Activity Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Category}" FontSize="12" TextColor="{DynamicResource ModeCardText2}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=CardText2" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding ExpGain, StringFormat='EXP: {0}'}" FontSize="12" TextColor="{DynamicResource ModeSecondaryAccentText}" FontAttributes="Bold" theme:ThemeColorExtensions.NamedColorProperties="TextColor=SecondaryAccentText" />
                                        <Label Text="{Binding MeaningfulUntilLevel, StringFormat='Cutoff: {0}'}" FontSize="12" TextColor="{DynamicResource ModeDisabledText}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=DisabledText" />
                                        <Label Text="{Binding Multiplier, StringFormat='x{0}'}" FontSize="12" TextColor="{DynamicResource ModeTimelineSalmon}" FontAttributes="Bold" IsVisible="{Binding ShowMultiplier}" theme:ThemeColorExtensions.NamedColorProperties="TextColor=TimelineSalmon" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Edit Button -->
                                <Button Grid.Column="2" Text="✏️" FontSize="18" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{DynamicResource ModeSecondaryButtonBackground}" TextColor="{DynamicResource ModeOnColorText}" Clicked="OnEditClicked" CommandParameter="{Binding .}" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SecondaryButtonBackground,TextColor=OnColorText" />

                                <!-- Duplicate Button -->
                                <Button Grid.Column="3" Text="📋" FontSize="18" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{DynamicResource ModeSuccessButtonBackground}" TextColor="{DynamicResource ModeOnColorText}" Clicked="OnDuplicateClicked" CommandParameter="{Binding .}" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SuccessButtonBackground,TextColor=OnColorText" />

                                <!-- Delete Button -->
                                <Button Grid.Column="4" Text="🗑️" FontSize="18" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{DynamicResource ModeErrorButtonBackground}" TextColor="{DynamicResource ModeOnColorText}" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=ErrorButtonBackground,TextColor=OnColorText" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Bottom Action Bar -->
        <Frame Grid.Row="2" Padding="15" CornerRadius="12" BackgroundColor="{DynamicResource ModeCardBackground}" HasShadow="True" BorderColor="Transparent" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=CardBackground">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                
                <Button Grid.Column="0" Text="Bulk Edit Selected" Clicked="OnBulkEditClicked" BackgroundColor="{DynamicResource ModeSecondaryButtonBackground}" TextColor="{DynamicResource ModeOnColorText}" CornerRadius="8" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=SecondaryButtonBackground,TextColor=OnColorText" />

                <Button Grid.Column="1" Text="Delete Selected" Clicked="OnDeleteSelectedClicked" BackgroundColor="{DynamicResource ModeErrorButtonBackground}" TextColor="{DynamicResource ModeOnColorText}" CornerRadius="8" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=ErrorButtonBackground,TextColor=OnColorText" />

                <Button Grid.Column="2" Text="Export to CSV" Clicked="OnExportClicked" BackgroundColor="{DynamicResource ModeHighlightAquaButton}" TextColor="{DynamicResource ModeOnColorText}" CornerRadius="8" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=HighlightAquaButton,TextColor=OnColorText" />

                <Button Grid.Column="3" Text="Close" Clicked="OnCloseClicked" BackgroundColor="{DynamicResource ModeDisabledButtonBackground}" TextColor="{DynamicResource ModeOnColorText}" CornerRadius="8" theme:ThemeColorExtensions.NamedColorProperties="BackgroundColor=DisabledButtonBackground,TextColor=OnColorText" />
            </Grid>
        </Frame>
    </Grid>
</mode:ModeThemedPage>
